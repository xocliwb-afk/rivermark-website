# Gmail API OAuth only. Run npm run forms:authorize for local owner consent.
# Real values belong only in .env.local (mode 600) or server-side environment settings.
# Access tokens are temporary in-memory values and must not be stored here.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_GMAIL_FROM=brandon@rivermarkinspections.com
RIVERMARK_FORM_TO=brandon@rivermarkinspections.com
# Only enable behind a trusted proxy that appends the actual client IP to X-Forwarded-For.
# Direct/local requests deliberately share a rate-limit bucket.
RIVERMARK_TRUST_PROXY=false
